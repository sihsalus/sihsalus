// Grafana Alloy configuration for SIHSALUS
// Based on upstream OpenMRS with SIHSALUS customizations

logging {
  level = "warn"
}

discovery.docker "linux" {
  host = "http://docker-socket-proxy:2375"
}

discovery.relabel "docker_logs" {
  targets = discovery.docker.linux.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container_name"
  }

  rule {
    action       = "replace"
    replacement  = "docker"
    target_label = "job"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }
}

loki.source.docker "docker_logs" {
  host       = "http://docker-socket-proxy:2375"
  targets    = discovery.relabel.docker_logs.output
  forward_to = [loki.process.docker_process.receiver]
}

loki.process "docker_process" {
  forward_to = [loki.write.local.receiver]

  // Drop noisy Loki internal logs
  stage.drop {
    expression = ".*(msg=\\\"(error notifying scheduler about finished query|error processing requests from scheduler|error health checking|error notifying frontend about finished query|error getting ingester clients)\\\"|msg=\\\"write operation failed\\\" details=\\\"entry too far behind).*"
  }

  // Grafana cancels superseded LogQL requests during refresh. Loki logs that
  // client cancellation as a warning although the subsequent query succeeds.
  stage.drop {
    expression = ".*msg=\\\"failed mapping AST\\\".*err=\\\"context canceled\\\".*"
  }

  // A Docker log tail is cancelled whenever discovery refreshes an idle
  // container. Alloy reports that cancellation as a warning even though it
  // transferred zero entries and no application log was lost. Do not feed
  // this collector-internal noise back into its own warning dashboard.
  stage.drop {
    expression = ".*msg=\\\"could not transfer logs\\\".*written=0.*(context deadline exceeded|Client.Timeout|request canceled).*"
  }

  // Join multiline logs (Java stack traces)
  stage.multiline {
    firstline = "^(?i)((\\d{4}[-/]\\d{2}[-/]\\d{2}|\\d{2}-[a-z]{3}-\\d{4}|ts=)|(trace|debug|info|warning|warn|error|fatal|panic|note))"
    max_wait_time = "3s"
  }

  // Access logs and other unstructured operational events are informational
  // unless an explicit severity below overrides this bounded default.
  stage.static_labels {
    values = { level = "info" }
  }

  // Extract only an explicit severity: a leading level (optionally after a
  // timestamp) or a structured level=/level: field. Searching for the words
  // anywhere classified benign fields such as Gatus errors=0 as errors.
  stage.regex {
    expression = "(?i)(?:^\\s*(?:\\d{4}[-/]\\d{2}[-/]\\d{2}[^ ]*\\s+)?|\\blevel[=:]\\s*)(?P<level>trace|debug|info|warning|warn|error|fatal|panic|note)\\b"
  }

  stage.labels {
    values = {
      level = "level",
    }
  }

  // Gatus emits structured success=true/false fields but no severity. Map the
  // bounded result explicitly instead of inferring it from errors=<count>.
  stage.match {
    selector = "{service_name=\"gatus\"} |~ \"success=true\""
    stage.static_labels {
      values = { level = "info" }
    }
  }

  stage.match {
    selector = "{service_name=\"gatus\"} |~ \"success=false\""
    stage.static_labels {
      values = { level = "error" }
    }
  }

  // Normalize log levels
  stage.match {
    selector = "{level=~\"(?i)warn(ing)?\"}"
    stage.static_labels {
      values = { level = "warn" }
    }
  }

  stage.match {
    selector = "{level=~\"(?i)(info|note)\"}"
    stage.static_labels {
      values = { level = "info" }
    }
  }

  stage.match {
    selector = "{level=~\"(?i)(error|fatal|panic)\"}"
    stage.static_labels {
      values = { level = "error" }
    }
  }

  // SIHSALUS-specific labels
  stage.static_labels {
    values = {
      environment = "production",
      application = "sihsalus",
    }
  }
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
