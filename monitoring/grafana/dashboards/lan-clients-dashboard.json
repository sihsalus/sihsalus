    {
      "id": 7,
      "type": "table",
      "title": "Equipos en el rango",
      "datasource": "Loki",
      "description": "Una fila por IP de la LAN. *service worker* = registró service-worker.js (offline posible). El navegador es el User-Agent más frecuente de esa IP.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": "Loki",
          "expr": "sum by (ip) (count_over_time({container_name=\"sihsalus-gateway\"} | regexp `^(?P<ip>\\d+\\.\\d+\\.\\d+\\.\\d+) ` | ip != \"\" | ip !~ `(172|127|10)\\..*` | ip =~ `$ip` [$__range]))",
          "refId": "A",
          "instant": true,
          "range": false,
          "queryType": "instant"
        },
        {
          "datasource": "Loki",
          "expr": "sum by (ip) (count_over_time({container_name=\"sihsalus-gateway\"} | regexp `^(?P<ip>\\d+\\.\\d+\\.\\d+\\.\\d+) ` | ip != \"\" | ip !~ `(172|127|10)\\..*` | ip =~ `$ip` |= `service-worker.js` [$__range]))",
          "refId": "B",
          "instant": true,
          "range": false,
          "queryType": "instant"
        },
        {
          "datasource": "Loki",
          "expr": "topk(1, sum by (ip, navegador) (count_over_time({container_name=\"sihsalus-gateway\"} | regexp `^(?P<ip>\\d+\\.\\d+\\.\\d+\\.\\d+) .* \"(?P<navegador>[^\"]*)\" \"[^\"]*\"$` | ip != \"\" | ip !~ `(172|127|10)\\..*` | ip =~ `$ip` [$__range]))) by (ip)",
          "refId": "C",
          "instant": true,
          "range": false,
          "queryType": "instant"
        }
      ],
      "transformations": [
