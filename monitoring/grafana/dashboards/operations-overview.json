      "targets": [
        { "editorMode": "code", "expr": "sum by (service_name) (count_over_time({job=\"docker\", service_name!=\"gatus\", level=\"error\"}[$__interval]))", "legendFormat": "{{service_name}}", "queryType": "range", "refId": "A" },
        { "editorMode": "code", "expr": "sum by (service_name) (count_over_time({job=\"docker\", service_name=\"gatus\"} |= `success=false` [$__interval]))", "legendFormat": "{{service_name}}", "queryType": "range", "refId": "B" }
      ],
      "title": "Errores por servicio",
