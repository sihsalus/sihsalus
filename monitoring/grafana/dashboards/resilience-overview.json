  "panels": [
    {
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": { "content": "# Resiliencia operativa\nVigila que existan backups cifrados recientes, las dos VPN permanezcan activas y el certificado no se acerque a su vencimiento. **La existencia de un archivo no sustituye una restauración de prueba.** iDRAC/RAID todavía requieren una integración Redfish con credenciales de solo lectura.", "mode": "markdown" },
      "title": "",
      "transparent": true,
      "type": "text"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Edad del artefacto cifrado más reciente por base de datos.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 1, "noValue": "SIN DATOS", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 8 }, { "color": "red", "value": 14 }] }, "unit": "h" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 9, "x": 0, "y": 4 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "center", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "(time() - sihsalus_backup_latest_timestamp_seconds) / 3600", "instant": true, "legendFormat": "{{backup}}", "range": false, "refId": "A" }],
      "title": "Edad de backups",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "tun0 corresponde a CloudConnexa; tun1 corresponde a GOREL.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "mappings": [{ "options": { "0": { "color": "red", "text": "ABAJO" }, "1": { "color": "green", "text": "ACTIVA" } }, "type": "value" }], "noValue": "NO DETECTADA", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] } }, "overrides": [] },
      "gridPos": { "h": 5, "w": 6, "x": 9, "y": 4 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name", "wideLayout": true },
      "targets": [{ "editorMode": "code", "expr": "node_network_carrier{device=~\"tun0|tun1\"}", "instant": true, "legendFormat": "{{device}}", "range": false, "refId": "A" }],
      "title": "VPN",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 0, "noValue": "SIN DATOS", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 7 }, { "color": "green", "value": 30 }] }, "unit": "d" }, "overrides": [] },
      "gridPos": { "h": 5, "w": 5, "x": 15, "y": 4 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "value_and_name" },
      "targets": [{ "editorMode": "code", "expr": "(probe_ssl_earliest_cert_expiry{job=\"blackbox-https-certificate\"} - time()) / 86400", "legendFormat": "Certificado", "range": true, "refId": "A" }],
      "title": "Días de certificado",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "decimals": 1, "noValue": "SIN SENSOR", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 80 }] }, "unit": "celsius" }, "overrides": [] },
