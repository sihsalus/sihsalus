        { "editorMode": "code", "expr": "rate(node_network_receive_bytes_total{device=~\"tun0|tun1\"}[5m])", "legendFormat": "RX {{device}}", "range": true, "refId": "A" },
        { "editorMode": "code", "expr": "rate(node_network_transmit_bytes_total{device=~\"tun0|tun1\"}[5m])", "legendFormat": "TX {{device}}", "range": true, "refId": "B" }
      ],
      "title": "Tráfico VPN",
