      "targets": [{ "editorMode": "code", "expr": "{job=\"docker\", service_name=~\"backend|gateway\", level=~\"warn|error\"}", "queryType": "range", "refId": "A" }],
      "title": "Eventos recientes",
      "type": "logs"
    }
