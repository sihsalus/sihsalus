# Installed on the dedicated terminology host; TLS is renewed by certbot.timer.
# Signed export query strings carry temporary credentials; log only the URI path.
log_format terminology '$remote_addr [$time_local] "$request_method $uri $server_protocol" $status $body_bytes_sent';
server {
    listen 80;
    access_log /var/log/nginx/terminology_access.log terminology;
    server_name ${TERMINOLOGY_HOST} ${TERMINOLOGY_API_HOST};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    access_log /var/log/nginx/terminology_access.log terminology;
    server_name ${TERMINOLOGY_HOST};
    ssl_certificate /etc/letsencrypt/live/${TERMINOLOGY_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${TERMINOLOGY_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 20m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location /terminology-exports/ {
        limit_except GET { deny all; }
        proxy_pass http://127.0.0.1:9000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
    }
    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}

server {
    listen 443 ssl;
    access_log /var/log/nginx/terminology_access.log terminology;
    server_name ${TERMINOLOGY_API_HOST};
    ssl_certificate /etc/letsencrypt/live/${TERMINOLOGY_HOST}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${TERMINOLOGY_HOST}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 100m;
    add_header X-Content-Type-Options nosniff always;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 180s;
    }
}
