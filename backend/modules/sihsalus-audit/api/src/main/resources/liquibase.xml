<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.5.xsd">

  <!-- Each implicit-commit DDL operation has its own recoverable changeSet. If MariaDB stops
       between operations, the next run skips completed objects and creates only what is missing. -->
  <changeSet id="sihsalusaudit-20260819-01-table" author="sihsalus">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not>
        <tableExists tableName="sihsalus_clinical_audit_event" />
      </not>
    </preConditions>
    <comment>Create the SIHSALUS clinical audit event table.</comment>
    <createTable tableName="sihsalus_clinical_audit_event">
      <column name="audit_event_id" type="bigint" autoIncrement="true">
        <constraints nullable="false" primaryKey="true" primaryKeyName="pk_sihsalus_clinical_audit" />
      </column>
      <column name="client_event_id" type="char(36)">
        <constraints nullable="false" />
      </column>
      <column name="event_type" type="varchar(64)">
        <constraints nullable="false" />
      </column>
      <column name="patient_uuid" type="char(38)" />
      <column name="encounter_uuid" type="char(38)" />
      <column name="resource_type" type="varchar(64)" />
      <column name="metadata_json" type="text" />
      <column name="client_occurred_at" type="datetime(3)" />
      <column name="actor_id" type="int">
        <constraints nullable="false" />
      </column>
      <column name="server_timestamp" type="datetime">
        <constraints nullable="false" />
      </column>
    </createTable>
  </changeSet>

  <changeSet id="sihsalusaudit-20260819-02-client-time" author="sihsalus">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not>
        <columnExists tableName="sihsalus_clinical_audit_event" columnName="client_occurred_at" />
      </not>
    </preConditions>
    <addColumn tableName="sihsalus_clinical_audit_event">
      <column name="client_occurred_at" type="datetime(3)" />
    </addColumn>
  </changeSet>

  <changeSet id="sihsalusaudit-20260819-03-actor-fk" author="sihsalus">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not>
        <foreignKeyConstraintExists foreignKeyName="fk_sihsalus_audit_actor" />
      </not>
    </preConditions>
    <addForeignKeyConstraint constraintName="fk_sihsalus_audit_actor"
      baseTableName="sihsalus_clinical_audit_event" baseColumnNames="actor_id"
      referencedTableName="users" referencedColumnNames="user_id" />
  </changeSet>

  <changeSet id="sihsalusaudit-20260819-04-idempotency" author="sihsalus">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not>
        <indexExists tableName="sihsalus_clinical_audit_event"
          indexName="uq_sihsalus_audit_actor_client" />
      </not>
    </preConditions>
    <addUniqueConstraint constraintName="uq_sihsalus_audit_actor_client"
      tableName="sihsalus_clinical_audit_event" columnNames="actor_id, client_event_id" />
  </changeSet>

  <changeSet id="sihsalusaudit-20260819-05-timestamp-index" author="sihsalus">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not>
        <indexExists tableName="sihsalus_clinical_audit_event" indexName="idx_sihsalus_audit_timestamp" />
      </not>
    </preConditions>
    <createIndex indexName="idx_sihsalus_audit_timestamp" tableName="sihsalus_clinical_audit_event">
      <column name="server_timestamp" />
    </createIndex>
  </changeSet>

  <changeSet id="sihsalusaudit-20260819-06-patient-index" author="sihsalus">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <not>
        <indexExists tableName="sihsalus_clinical_audit_event" indexName="idx_sihsalus_audit_patient" />
      </not>
    </preConditions>
    <createIndex indexName="idx_sihsalus_audit_patient" tableName="sihsalus_clinical_audit_event">
      <column name="patient_uuid" />
      <column name="server_timestamp" />
    </createIndex>
  </changeSet>

  <!-- The application DB user may INSERT and SELECT, but row mutation is rejected in the
       supported MariaDB/MySQL runtime. An approved retention migration must explicitly replace
       these triggers before deleting or archiving evidence. -->
  <changeSet id="sihsalusaudit-20260819-07-no-update" author="sihsalus"
    dbms="mysql,mariadb" runAlways="true">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <sqlCheck expectedResult="0"><![CDATA[
        SELECT COUNT(*) FROM information_schema.TRIGGERS
        WHERE TRIGGER_SCHEMA = DATABASE() AND TRIGGER_NAME = 'sihsalus_audit_no_update'
      ]]></sqlCheck>
    </preConditions>
    <sql splitStatements="false"><![CDATA[
      CREATE TRIGGER sihsalus_audit_no_update
      BEFORE UPDATE ON sihsalus_clinical_audit_event
      FOR EACH ROW SIGNAL SQLSTATE '45000'
      SET MESSAGE_TEXT = 'Clinical audit rows are append-only'
    ]]></sql>
  </changeSet>

  <changeSet id="sihsalusaudit-20260819-08-no-delete" author="sihsalus"
    dbms="mysql,mariadb" runAlways="true">
    <preConditions onFail="MARK_RAN" onError="HALT">
      <sqlCheck expectedResult="0"><![CDATA[
        SELECT COUNT(*) FROM information_schema.TRIGGERS
        WHERE TRIGGER_SCHEMA = DATABASE() AND TRIGGER_NAME = 'sihsalus_audit_no_delete'
      ]]></sqlCheck>
    </preConditions>
    <sql splitStatements="false"><![CDATA[
      CREATE TRIGGER sihsalus_audit_no_delete
      BEFORE DELETE ON sihsalus_clinical_audit_event
      FOR EACH ROW SIGNAL SQLSTATE '45000'
      SET MESSAGE_TEXT = 'Clinical audit rows are append-only'
    ]]></sql>
  </changeSet>

  <changeSet id="sihsalusaudit-20260819-09-validate" author="sihsalus" runAlways="true">
    <preConditions onFail="HALT" onError="HALT">
      <tableExists tableName="sihsalus_clinical_audit_event" />
      <primaryKeyExists tableName="sihsalus_clinical_audit_event"
        primaryKeyName="pk_sihsalus_clinical_audit" />
      <columnExists tableName="sihsalus_clinical_audit_event" columnName="audit_event_id" />
      <columnExists tableName="sihsalus_clinical_audit_event" columnName="client_event_id" />
      <columnExists tableName="sihsalus_clinical_audit_event" columnName="event_type" />
      <columnExists tableName="sihsalus_clinical_audit_event" columnName="patient_uuid" />
      <columnExists tableName="sihsalus_clinical_audit_event" columnName="encounter_uuid" />
      <columnExists tableName="sihsalus_clinical_audit_event" columnName="resource_type" />
      <columnExists tableName="sihsalus_clinical_audit_event" columnName="metadata_json" />
      <columnExists tableName="sihsalus_clinical_audit_event" columnName="client_occurred_at" />
      <columnExists tableName="sihsalus_clinical_audit_event" columnName="actor_id" />
      <columnExists tableName="sihsalus_clinical_audit_event" columnName="server_timestamp" />
      <foreignKeyConstraintExists foreignKeyName="fk_sihsalus_audit_actor" />
      <indexExists tableName="sihsalus_clinical_audit_event"
        indexName="uq_sihsalus_audit_actor_client" />
      <indexExists tableName="sihsalus_clinical_audit_event" indexName="idx_sihsalus_audit_timestamp" />
      <indexExists tableName="sihsalus_clinical_audit_event" indexName="idx_sihsalus_audit_patient" />
    </preConditions>
    <sql>SELECT 1</sql>
  </changeSet>

  <changeSet id="sihsalusaudit-20260819-10-mariadb-validate" author="sihsalus"
    dbms="mysql,mariadb" runAlways="true">
    <preConditions onFail="HALT" onError="HALT">
      <sqlCheck expectedResult="1"><![CDATA[
        SELECT CASE
          WHEN COUNT(*) = 2
            AND MAX(NON_UNIQUE) = 0
            AND SUM(CASE WHEN SEQ_IN_INDEX = 1 AND COLUMN_NAME = 'actor_id' THEN 1 ELSE 0 END) = 1
            AND SUM(CASE WHEN SEQ_IN_INDEX = 2 AND COLUMN_NAME = 'client_event_id' THEN 1 ELSE 0 END) = 1
          THEN 1 ELSE 0 END
        FROM information_schema.STATISTICS
        WHERE TABLE_SCHEMA = DATABASE()
          AND TABLE_NAME = 'sihsalus_clinical_audit_event'
          AND INDEX_NAME = 'uq_sihsalus_audit_actor_client'
      ]]></sqlCheck>
      <sqlCheck expectedResult="1"><![CDATA[
        SELECT COUNT(*) FROM information_schema.TRIGGERS
        WHERE TRIGGER_SCHEMA = DATABASE()
          AND TRIGGER_NAME = 'sihsalus_audit_no_update'
          AND EVENT_OBJECT_TABLE = 'sihsalus_clinical_audit_event'
          AND ACTION_TIMING = 'BEFORE'
          AND EVENT_MANIPULATION = 'UPDATE'
      ]]></sqlCheck>
      <sqlCheck expectedResult="1"><![CDATA[
        SELECT COUNT(*) FROM information_schema.TRIGGERS
        WHERE TRIGGER_SCHEMA = DATABASE()
          AND TRIGGER_NAME = 'sihsalus_audit_no_delete'
          AND EVENT_OBJECT_TABLE = 'sihsalus_clinical_audit_event'
          AND ACTION_TIMING = 'BEFORE'
          AND EVENT_MANIPULATION = 'DELETE'
      ]]></sqlCheck>
    </preConditions>
    <sql>SELECT 1</sql>
  </changeSet>
</databaseChangeLog>
