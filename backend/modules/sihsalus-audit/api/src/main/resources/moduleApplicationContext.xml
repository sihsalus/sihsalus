<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.springframework.org/schema/beans
    http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

  <bean id="sihsalusClinicalAuditDao"
    class="org.openmrs.module.sihsalusaudit.api.db.hibernate.HibernateClinicalAuditDao">
    <property name="sessionFactory" ref="dbSessionFactory" />
  </bean>

  <bean id="sihsalusAuditSecurityContext"
    class="org.openmrs.module.sihsalusaudit.api.impl.OpenmrsAuditSecurityContext" />

  <bean id="sihsalusAuditClock"
    class="org.openmrs.module.sihsalusaudit.api.impl.SystemAuditClock" />

  <bean id="sihsalusClinicalAuditService"
    class="org.springframework.transaction.interceptor.TransactionProxyFactoryBean">
    <property name="transactionManager" ref="transactionManager" />
    <property name="target">
      <bean class="org.openmrs.module.sihsalusaudit.api.impl.ClinicalAuditServiceImpl">
        <property name="dao" ref="sihsalusClinicalAuditDao" />
        <property name="securityContext" ref="sihsalusAuditSecurityContext" />
        <property name="clock" ref="sihsalusAuditClock" />
      </bean>
    </property>
    <property name="preInterceptors" ref="serviceInterceptors" />
    <property name="transactionAttributes">
      <props>
        <prop key="recordEvents">PROPAGATION_REQUIRED</prop>
        <prop key="getEvents">PROPAGATION_REQUIRED,readOnly</prop>
      </props>
    </property>
  </bean>

  <bean parent="serviceContext">
    <property name="moduleService">
      <list merge="true">
        <value>org.openmrs.module.sihsalusaudit.api.ClinicalAuditService</value>
        <ref bean="sihsalusClinicalAuditService" />
      </list>
    </property>
  </bean>
</beans>
