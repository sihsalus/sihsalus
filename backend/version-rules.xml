<?xml version="1.0" encoding="UTF-8"?>
<ruleset comparisonMethod="maven"
  xmlns="http://mojo.codehaus.org/versions-maven-plugin/rule/2.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://mojo.codehaus.org/versions-maven-plugin/rule/2.0.0
    https://www.mojohaus.org/versions-maven-plugin/xsd/rule-2.0.0.xsd">
  <rules>
    <!-- Never auto-update OpenMRS Core -->
    <rule groupId="org.openmrs.web" artifactId="openmrs-webapp">
      <ignoreVersions>
        <ignoreVersion type="regex">.*</ignoreVersion>
      </ignoreVersions>
    </rule>
    <!-- Bahmni upgrades include schema and workflow changes; managed manually -->
    <rule groupId="org.bahmni.module" artifactId="appointments-omod">
      <ignoreVersions>
        <ignoreVersion type="regex">.*</ignoreVersion>
      </ignoreVersions>
    </rule>
    <rule groupId="org.bahmni.module" artifactId="teleconsultation-omod">
      <ignoreVersions>
        <ignoreVersion type="regex">.*</ignoreVersion>
      </ignoreVersions>
    </rule>
    <!-- REST is built from a pinned source revision with a security backport. -->
    <rule groupId="org.openmrs.module" artifactId="webservices.rest-omod">
      <ignoreVersions>
        <ignoreVersion type="regex">.*</ignoreVersion>
      </ignoreVersions>
    </rule>
    <!-- LegacyUI 3.x requires openmrs-core 3.0.0+ -->
    <rule groupId="org.openmrs.module" artifactId="legacyui-omod">
      <ignoreVersions>
        <ignoreVersion type="regex">([3-9]|[1-9]\d+)\..*</ignoreVersion>
      </ignoreVersions>
    </rule>
    <rule groupId="org.openmrs.module" artifactId="initializer-omod">
      <ignoreVersions>
        <ignoreVersion type="regex">.*</ignoreVersion>
      </ignoreVersions>
    </rule>
    <rule groupId="org.openmrs.module" artifactId="queue-omod">
      <ignoreVersions>
        <ignoreVersion type="regex">.*</ignoreVersion>
      </ignoreVersions>
    </rule>
    <rule groupId="org.openmrs.module" artifactId="reporting-omod">
      <ignoreVersions>
        <ignoreVersion type="regex">.*</ignoreVersion>
      </ignoreVersions>
    </rule>
    <rule groupId="org.openmrs.module" artifactId="reportingrest-omod">
      <ignoreVersions>
        <ignoreVersion type="regex">.*</ignoreVersion>
      </ignoreVersions>
    </rule>
    <rule groupId="org.openmrs.module" artifactId="patientdocuments-omod">
      <ignoreVersions>
        <ignoreVersion type="regex">.*</ignoreVersion>
      </ignoreVersions>
    </rule>
    <rule groupId="org.openmrs.module" artifactId="billing-omod">
      <ignoreVersions>
        <ignoreVersion type="regex">.*</ignoreVersion>
      </ignoreVersions>
    </rule>
    <rule groupId="org.openmrs.module" artifactId="emrapi-omod">
      <ignoreVersions>
        <ignoreVersion type="regex">.*</ignoreVersion>
      </ignoreVersions>
    </rule>
    <rule groupId="org.openmrs.module" artifactId="fhir2-omod">
      <ignoreVersions>
        <ignoreVersion type="regex">.*</ignoreVersion>
      </ignoreVersions>
    </rule>
    <rule groupId="org.openmrs.module" artifactId="authentication-omod">
      <ignoreVersions>
        <ignoreVersion type="regex">.*</ignoreVersion>
      </ignoreVersions>
    </rule>
    <!-- O3 Forms includes a pinned translation-loading correction. -->
    <rule groupId="org.openmrs.module" artifactId="o3forms-omod">
      <ignoreVersions>
        <ignoreVersion type="regex">.*</ignoreVersion>
      </ignoreVersions>
    </rule>
    <rule groupId="org.openmrs.module" artifactId="bedmanagement-omod">
      <ignoreVersions>
        <ignoreVersion type="regex">.*</ignoreVersion>
      </ignoreVersions>
    </rule>
  </rules>
</ruleset>
