+package org.openmrs.module.o3forms.api.impl;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Optional;
+
+import org.junit.Test;
+import org.openmrs.FormResource;
+import org.openmrs.api.context.Context;
+import org.openmrs.api.db.ClobDatatypeStorage;
+import org.openmrs.web.test.BaseModuleWebContextSensitiveTest;
+import org.springframework.test.util.ReflectionTestUtils;
+
+public class O3FormsLocaleTest extends BaseModuleWebContextSensitiveTest {
+
+	private FormResource translationResource(String language, String label) {
+		ClobDatatypeStorage storage = new ClobDatatypeStorage();
+		storage.setValue("{\"translations\":{\"synthetic-label\":\"" + label + "\"}}");
+		Context.getDatatypeService().saveClobDatatypeStorage(storage);
+		FormResource resource = new FormResource();
+		resource.setName("synthetic_form_translations_" + language);
+		resource.setValueReferenceInternal(storage.getUuid());
+		return resource;
+	}
+
+	private Optional<Map<String, Object>> translations(LinkedHashSet<Locale> locales, List<FormResource> resources) {
+		// Exercise the exact preferred-locale boundary without modifying Core's shared locale caches.
+		List<Locale> originalLocales = new ArrayList<>(locales);
+		Optional<Map<String, Object>> result = ReflectionTestUtils.invokeMethod(new O3FormsServiceImpl(),
+		    "getTranslationsByPreferredLocales", locales, resources);
+		assertEquals("The caller's locales and their order must be preserved", originalLocales, new ArrayList<>(locales));
+		return result;
+	}
+
+	@Test
+	public void shouldSkipNullBeforeAnAvailableTranslation() {
+		LinkedHashSet<Locale> locales = new LinkedHashSet<>(Arrays.asList(null, Locale.ENGLISH));
+		Optional<Map<String, Object>> result = translations(locales,
+		    Collections.singletonList(translationResource("en", "Synthetic English")));
+		assertTrue(result.isPresent());
+		assertEquals("Synthetic English", result.get().get("synthetic-label"));
+	}
+
+	@Test
+	public void shouldContinuePastNullToTheNextConfiguredLocale() {
+		LinkedHashSet<Locale> locales = new LinkedHashSet<>(Arrays.asList(Locale.FRENCH, null, Locale.ENGLISH));
+		Optional<Map<String, Object>> result = translations(locales,
+		    Collections.singletonList(translationResource("en", "Synthetic English")));
+		assertTrue(result.isPresent());
+		assertEquals("Synthetic English", result.get().get("synthetic-label"));
+	}
+
+	@Test
+	public void shouldNotInventAFallbackWhenOnlyNullIsAvailable() {
+		LinkedHashSet<Locale> locales = new LinkedHashSet<>(Collections.singletonList(null));
+		assertFalse(translations(locales,
+		    Collections.singletonList(translationResource("en", "Synthetic English"))).isPresent());
+	}
+
+	@Test
+	public void shouldLeaveTranslationsAbsentWhenNoResourceMatches() {
+		LinkedHashSet<Locale> locales = new LinkedHashSet<>(Arrays.asList(Locale.FRENCH, null));
+		assertFalse(translations(locales,
+		    Collections.singletonList(translationResource("en", "Synthetic English"))).isPresent());
+	}
+
+	@Test
+	public void shouldPreserveTheFirstAvailableLocaleAndTheInputSet() {
+		LinkedHashSet<Locale> locales = new LinkedHashSet<>(Arrays.asList(new Locale("es"), null, Locale.ENGLISH));
+		Optional<Map<String, Object>> result = translations(locales, Arrays.asList(
+		    translationResource("en", "Synthetic English"), translationResource("es", "Synthetic Spanish")));
+		assertTrue(result.isPresent());
+		assertEquals("Synthetic Spanish", result.get().get("synthetic-label"));
+	}
+
+	@Test
+	public void shouldLeaveTranslationsAbsentForAnEmptyLocaleSet() {
+		assertFalse(translations(new LinkedHashSet<>(),
+		    Collections.singletonList(translationResource("en", "Synthetic English"))).isPresent());
+	}
+}
