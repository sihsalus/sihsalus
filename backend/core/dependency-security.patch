+package org.openmrs.web.filter;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.Map;
+
+import javax.servlet.http.HttpServletRequest;
+import javax.servlet.http.HttpServletResponse;
+
+import org.junit.jupiter.api.Test;
+import org.springframework.mock.web.MockFilterConfig;
+import org.springframework.mock.web.MockHttpServletResponse;
+
+public class StartupVelocityTest {
+
+    @Test
+    public void render_shouldLoadStartupTemplatesAndLocalizeWithoutDatabase() throws Exception {
+        TestFilter filter = new TestFilter();
+        filter.init(new MockFilterConfig());
+        try {
+            Map<String, Object> model = new HashMap<>();
+            model.put("locale", "es");
+            model.put("HEADER_TEMPLATE", "org/openmrs/web/filter/initialization/header.vm");
+            model.put("FOOTER_TEMPLATE", "org/openmrs/web/filter/footer.vm");
+            model.put("OPENMRS_VERSION", "synthetic-test");
+            model.put("workLog", Collections.emptyList());
+            MockHttpServletResponse response = new MockHttpServletResponse();
+            filter.renderTemplate("initialization/chooselang.vm", model, response);
+            String html = response.getContentAsString();
+            assertTrue(html.contains("Español"));
+            assertTrue(html.contains("Continuar"));
+            assertTrue(html.contains("synthetic-test"));
+            assertFalse(html.contains("$l10n"));
+            assertFalse(html.contains("#parse"));
+
+            model.put("locale", "en");
+            model.put("HEADER_TEMPLATE", "org/openmrs/web/filter/update/header.vm");
+            model.put("superuserrole", "System Developer");
+            response = new MockHttpServletResponse();
+            filter.renderTemplate("update/maintenance.vm", model, response);
+            html = response.getContentAsString();
+            assertTrue(html.contains("name=\"username\""));
+            assertTrue(html.contains("name=\"password\""));
+            assertTrue(html.contains("Continue"));
+            assertFalse(html.contains("$l10n"));
+        } finally {
+            filter.destroy();
+        }
+    }
+
+    private static class TestFilter extends StartupFilter {
+        @Override
+        protected void doGet(HttpServletRequest request, HttpServletResponse response) throws IOException {
+        }
+
+        @Override
+        protected void doPost(HttpServletRequest request, HttpServletResponse response) throws IOException {
+        }
+
+        @Override
+        protected Object getUpdateFilterModel() {
+            return new Object();
+        }
+
+        @Override
+        public boolean skipFilter(HttpServletRequest request) {
+            return false;
+        }
+    }
+}
