diff --git a/api/src/test/java/org/openmrs/notification/mail/velocity/VelocityMessagePreparatorTest.java b/api/src/test/java/org/openmrs/notification/mail/velocity/VelocityMessagePreparatorTest.java
new file mode 100644
index 0000000..68f5ed8
--- /dev/null
+++ b/api/src/test/java/org/openmrs/notification/mail/velocity/VelocityMessagePreparatorTest.java
@@ -0,0 +1,64 @@
+/**
+ * This Source Code Form is subject to the terms of the Mozilla Public License,
+ * v. 2.0. If a copy of the MPL was not distributed with this file, You can
+ * obtain one at http://mozilla.org/MPL/2.0/. OpenMRS is also distributed under
+ * the terms of the Healthcare Disclaimer located at http://openmrs.org/license.
+ *
+ * Copyright (C) OpenMRS Inc. OpenMRS is a registered trademark and the OpenMRS
+ * graphic logo is a trademark of OpenMRS Inc.
+ */
+package org.openmrs.notification.mail.velocity;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static org.junit.jupiter.api.Assertions.assertSame;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import java.util.HashMap;
+import java.util.Map;
+
+import org.apache.velocity.VelocityContext;
+import org.apache.velocity.exception.MethodInvocationException;
+import org.apache.velocity.util.introspection.Info;
+import org.junit.jupiter.api.Test;
+import org.openmrs.notification.Message;
+import org.openmrs.notification.Template;
+import org.openmrs.util.VelocityExceptionHandler;
+
+public class VelocityMessagePreparatorTest {
+
+    @Test
+    public void prepare_shouldPreserveLegacyTemplatesAndMessageHeaders() throws Exception {
+        Template template = new Template();
+        template.setTemplate("Hola $patient-name: #if($count)$count#end|#if($empty)present#end|$!missing");
+        template.setSubject("Recordatorio sintético");
+        template.setSender("test@example.invalid");
+        template.setRecipients("recipient@example.invalid");
+        Map<String, Object> data = new HashMap<>();
+        data.put("patient-name", "José");
+        data.put("count", 0);
+        data.put("empty", "");
+        template.setData(data);
+        Message message = new VelocityMessagePreparator().prepare(template);
+        assertEquals("Hola José: 0|present|", message.getContent());
+        assertEquals(template.getSubject(), message.getSubject());
+        assertEquals(template.getSender(), message.getSender());
+        assertEquals(template.getRecipients(), message.getRecipients());
+    }
+
+    @Test
+    public void methodException_shouldPreserveDateFallbackAndPropagateOtherFailures() throws Exception {
+        VelocityExceptionHandler handler = new VelocityExceptionHandler();
+        IllegalArgumentException failure = new IllegalArgumentException("synthetic invalid date");
+        VelocityContext context = new VelocityContext();
+        Info info = new Info("synthetic", 1, 1);
+        assertNull(handler.methodException(context, String.class, "format", failure, info));
+        assertSame(failure, assertThrows(IllegalArgumentException.class,
+            () -> handler.methodException(context, String.class, "other", failure, info)));
+        Exception checkedFailure = new Exception("synthetic checked failure");
+        MethodInvocationException wrapped = assertThrows(MethodInvocationException.class,
+            () -> handler.methodException(context, String.class, "other", checkedFailure, info));
+        assertSame(checkedFailure, wrapped.getCause());
+        assertEquals("synthetic", wrapped.getTemplateName());
+    }
+}
