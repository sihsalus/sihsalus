+	@Override
+	public void lockPatient(Patient patient) {
+		sessionFactory.getCurrentSession().get(Patient.class, patient.getId(), LockMode.PESSIMISTIC_WRITE);
+	}
+
+	@Override
+	public List<Condition> getActiveConditionsForUpdate(Patient patient) {
+		return activeConditionsQuery(patient)
+			// A locking read sees commits made before acquiring the patient lock,
+			// including under MySQL's REPEATABLE READ isolation.
+			.setLockMode(LockModeType.PESSIMISTIC_WRITE)
+			.getResultList();
