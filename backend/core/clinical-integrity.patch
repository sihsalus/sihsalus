+	private Query<Condition> activeConditionsQuery(Patient patient) {
+		return sessionFactory.getCurrentSession().createQuery(
+			"from Condition c where c.patient.patientId = :patientId "
+				+ "and c.clinicalStatus in :activeStatuses and c.voided = false order by c.dateCreated desc",
+			Condition.class)
+			.setParameter("patientId", patient.getId())
+			.setParameter("activeStatuses", Arrays.asList(ACTIVE, RECURRENCE, RELAPSE));
+	}
