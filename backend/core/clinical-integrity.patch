+	private void validateActiveCondition(Condition condition, Integer originalId) {
+		if (BooleanUtils.isTrue(condition.getVoided()) || condition.getCondition() == null
+		        || condition.getCondition().getCoded() == null
+		        || !Arrays.asList(ConditionClinicalStatus.ACTIVE, ConditionClinicalStatus.RECURRENCE,
+		            ConditionClinicalStatus.RELAPSE).contains(condition.getClinicalStatus())) {
+			return;
+		}
+		boolean duplicate = conditionDAO.getActiveConditionsForUpdate(condition.getPatient()).stream()
+			.anyMatch(existing -> !Objects.equals(existing.getId(), originalId)
+			    && existing.getCondition() != null
+			    && condition.getCondition().getCoded().equals(existing.getCondition().getCoded())
+			    // Supplemental context may distinguish a family antecedent from the patient's condition.
+			    && StringUtils.defaultString(condition.getAdditionalDetail())
+			        .equals(StringUtils.defaultString(existing.getAdditionalDetail())));
+		if (duplicate) {
+			Errors errors = new BindException(condition, "condition");
+			errors.rejectValue("condition", "Condition.activeDuplicate",
+			    "This patient already has an active condition with this concept. Update it or resolve it before recording another episode.");
+			throw new ValidationException(errors);
+		}
+	}
+
 }
