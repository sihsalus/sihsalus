# Clinical uploads enter through OpenMRS. Imaging has its own bounded allowance;
# all other routes retain the existing default cap.
client_max_body_size 100m;

include /etc/nginx/includes/security-headers.conf;

# Redis stores the session and refresh lock. Only the small ticket cookie is
# returned by auth_request; forward its renewal/deletion without rewriting it.
large_client_header_buffers 4 8k;
auth_request_set $imaging_auth_cookie $upstream_http_set_cookie;
add_header Set-Cookie $imaging_auth_cookie always;

proxy_set_header      HOST $host;
proxy_set_header      X-Forwarded-Proto $forwarded_proto;
proxy_set_header      X-Real-IP $forwarded_ip;
proxy_set_header      X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_http_version    1.1;

# All redirects are relative to the gateway
absolute_redirect off;

# Healthcheck del gateway: respondido por nginx sin tocar upstreams.
location = /health {
  access_log off;
  default_type text/plain;
  return 200 'OK';
}

# The SPA emits a bodyless heartbeat while a visible user has interacted
# recently. This log contains only a timestamp and never clinical context.
location = /_sihsalus/clinical-activity {
  client_max_body_size 1k;
  access_log /var/log/nginx/clinical-activity.log clinical_activity;
  add_header Cache-Control 'no-store' always;
  include /etc/nginx/includes/security-headers.conf;
  return 204;
}

# Startup del backend: valida que OpenMRS/Tomcat responda, aunque siga
# ejecutando Initial Setup o imports de metadata.
location = /startup {
  access_log off;
  set $backend_health http://backend:8080;
  proxy_intercept_errors on;
  proxy_pass $backend_health/openmrs/initialsetup;
  error_page 301 302 303 307 308 = @backend_started;
  error_page 500 502 503 504 = @backend_not_started;
}

location @backend_started {
  default_type text/plain;
  return 200 'STARTED';
}

location @backend_not_started {
  default_type text/plain;
  add_header Retry-After 30 always;
  include /etc/nginx/includes/security-headers.conf;
  return 503 'NOT_STARTED';
}

# Readiness global: valida que OpenMRS ya termino su bootstrap completo.
location = /ready {
  access_log off;
  set $backend_health http://backend:8080;
  proxy_intercept_errors on;
  proxy_pass $backend_health/openmrs/health/started;
  error_page 500 502 503 504 = @openmrs_not_ready;
}

location @openmrs_not_ready {
  default_type text/plain;
  add_header Retry-After 30 always;
  add_header X-SIHSALUS-Readiness 'openmrs-bootstrap-pending' always;
  include /etc/nginx/includes/security-headers.conf;
  return 503 'NOT_READY: OpenMRS bootstrap is not complete';
}

location /openmrs/spa/ {
  set $frontend http://frontend;
  rewrite ^/openmrs/spa/(.*) /$1 break;
  proxy_pass $frontend;
}

location = /ayuda {
  return 301 /ayuda/;
}

location /ayuda/ {
  set $docs http://docs:8080;
  rewrite ^/ayuda/(.*)$ /$1 break;
  proxy_set_header Host docs;
  proxy_read_timeout 30s;
  proxy_intercept_errors on;
  proxy_redirect http://docs:8080/ /ayuda/;
  error_page 502 503 504 = @docs_unavailable;
  proxy_pass $docs;
}

location @docs_unavailable {
  default_type text/html;
  return 503 '<!doctype html><html lang="es"><head><meta charset="utf-8"><title>Ayuda no disponible</title></head><body><h1>Ayuda temporalmente no disponible</h1><p>Puede continuar utilizando SIHSALUS e intentarlo nuevamente m&aacute;s tarde.</p></body></html>';
}

# Password recovery is administrator-mediated. Legacy's secret-question
# endpoint is intentionally unavailable, including POST requests.
location ~ "^/openmrs(;[^/]*)?/forgotPassword[.]form(;[^/]*)?(/|$)" {
  return 404;
}

# Legacy password change returns to /openmrs/index.htm. Keep the user in O3.
location = /openmrs/index.htm {
  return 302 /openmrs/spa/home;
}

location = /keycloak {
  return 301 /keycloak/;
}

location /keycloak/ {
  set $keycloak http://keycloak:8080;
  rewrite ^/keycloak/(.*) /$1 break;
  proxy_set_header HOST $host;
  proxy_set_header X-Forwarded-Host $host;
  proxy_set_header X-Forwarded-Proto $forwarded_proto;
  proxy_set_header X-Forwarded-Port $server_port;
  proxy_set_header X-Forwarded-Prefix /keycloak;
  proxy_read_timeout 300s;
  proxy_pass $keycloak;
}

# Authenticated OpenMRS realtime notifications. Preserve the public host so
# the OMOD can enforce exact same-origin before accepting the upgrade.
location = /openmrs/ws/sihsalus/notifications {
  set $backend http://backend:8080;
  proxy_set_header HOST $http_host;
  proxy_set_header X-Forwarded-Proto $forwarded_proto;
  proxy_set_header X-Real-IP $forwarded_ip;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_read_timeout 1810s;
  proxy_pass $backend;
}

location ~ ^/openmrs/ws/sihsalus/notifications/sse/?$ {
  set $backend http://backend:8080;
  proxy_buffering off;
  proxy_cache off;
  proxy_read_timeout 130s;
  proxy_pass $backend;
}

# One DICOM file can contain 200,000,000 bytes, plus multipart metadata. Keep
# this transport allowance scoped to the module's upload endpoint. OpenMRS
# retains session/privilege checks and validates the configured file limit.
location = /openmrs/ws/rest/v1/imaging/instances {
  client_max_body_size 200m;
  set $backend http://backend:8080;
  proxy_read_timeout 300s;
  proxy_next_upstream off;
  proxy_pass $backend;
  proxy_intercept_errors on;
  error_page 502 503 504 = @backend_unavailable;
}

# OpenMRS Backend
location /openmrs {
  if ($sihsalus_social_redirect) { return 302 /openmrs/spa/home; }
  set $backend http://backend:8080;
  proxy_read_timeout 300s;
  proxy_pass $backend;
  # Mientras el backend inicializa (primer arranque puede tardar >30 min)
  # se muestra una pagina de espera en lugar del 502 generico.
  proxy_intercept_errors on;
  error_page 502 503 504 = @backend_unavailable;
}

location = /_sihsalus/backend-unavailable.css {
  alias /usr/share/nginx/html/backend-unavailable.css;
}

location @backend_unavailable {
  default_type text/html;
  add_header Retry-After 30 always;
  include /etc/nginx/includes/security-headers.conf;
  return 503 '<!DOCTYPE html><html lang="es"><head><meta charset="utf-8"><meta http-equiv="refresh" content="30"><title>SIH Salus - Iniciando</title><link rel="stylesheet" href="/_sihsalus/backend-unavailable.css"></head><body><div><h1>SIH Salus se est&aacute; iniciando</h1><p>OpenMRS todav&iacute;a est&aacute; terminando su bootstrap. En el primer arranque puede cargar configuraci&oacute;n, conceptos y mappings OCL durante varios minutos.</p><p>Verifica <code>/startup</code> para saber si el backend responde y <code>/ready</code> para saber si ya puede atender tr&aacute;fico cl&iacute;nico.</p><p>Esta p&aacute;gina se actualizar&aacute; autom&aacute;ticamente.</p></div></body></html>';
}

# OIDC endpoints for individually authorized Imaging access. Token exchange
# remains internal; only browser authorization redirects through Keycloak.
location = /imaging/oauth2/auth {
  internal;
  set $imaging_auth http://imaging-auth:4180;
  proxy_pass_request_body off;
  proxy_set_header Content-Length "";
  proxy_set_header Host $http_host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-Proto $forwarded_proto;
  proxy_set_header X-Forwarded-Host $http_host;
  proxy_set_header X-Forwarded-Uri $request_uri;
  proxy_set_header X-Original-URI $request_uri;
  proxy_buffer_size 16k;
  proxy_buffers 4 16k;
  proxy_pass $imaging_auth/imaging/oauth2/auth;
}

location /imaging/oauth2/ {
  if ($imaging_invalid_host) { return 400; }
  if ($imaging_cookie_too_large) { return 400; }
  ${IMAGING_NETWORK_ACCESS_CONTROL}
  set $imaging_auth http://imaging-auth:4180;
  proxy_set_header Host $http_host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-Proto $forwarded_proto;
  proxy_set_header X-Forwarded-Host $http_host;
  proxy_set_header X-Auth-Request-Redirect $forwarded_proto://$http_host$request_uri;
  proxy_buffer_size 16k;
  proxy_buffers 4 16k;
  proxy_pass $imaging_auth;
}

location @imaging_oauth_signin {
  # Let oauth2-proxy encode the return URL in its OIDC state. Concatenating
  # request_uri into ?rd= truncates URLs with multiple query parameters.
  set $imaging_auth http://imaging-auth:4180;
  proxy_method GET;
  proxy_pass_request_body off;
  proxy_set_header Content-Length "";
  proxy_set_header Host $http_host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-Proto $forwarded_proto;
  proxy_set_header X-Forwarded-Host $http_host;
  proxy_set_header X-Auth-Request-Redirect $request_uri;
  proxy_buffer_size 16k;
  proxy_buffers 4 16k;
  proxy_pass $imaging_auth/imaging/oauth2/start;
}

location = /imaging/logout {
  return 302 /imaging/oauth2/sign_out?rd=/;
}

# OHIF Imaging Viewer
location = /imaging {
  return 301 /imaging/;
}

location = /orthanc {
  if ($imaging_read_method_denied) { return 403; }
  return 301 /orthanc/;
}

location = /orthanc/ui/app {
  if ($imaging_read_method_denied) { return 403; }
  return 301 /orthanc/ui/app/$is_args$args;
}

location /orthanc/ {
  if ($orthanc_web_method_denied) { return 403; }
  ${IMAGING_ACCESS_CONTROL}
  include /etc/nginx/includes/imaging-proxy-headers.conf;
  set $orthanc_proxy http://orthanc-proxy;
  # The only public POSTs are small read queries from Orthanc Explorer.
  client_max_body_size 1m;
  rewrite ^/orthanc/(.*)$ /$1 break;
  proxy_read_timeout 300s;
  proxy_pass $orthanc_proxy;
}

# DICOM endpoints when OHIF runs under /imaging
location = /imaging/dicom-web {
  if ($imaging_read_method_denied) { return 403; }
  return 301 /imaging/dicom-web/studies;
}

location /imaging/dicom-web/ {
  if ($imaging_read_method_denied) { return 403; }
  ${IMAGING_ACCESS_CONTROL}
  include /etc/nginx/includes/imaging-proxy-headers.conf;
  set $orthanc_proxy http://orthanc-proxy;
  rewrite ^/imaging/(.*)$ /$1 break;
  proxy_read_timeout 300s;
  proxy_pass $orthanc_proxy;
}

location /imaging/wado {
  if ($imaging_read_method_denied) { return 403; }
  ${IMAGING_ACCESS_CONTROL}
  include /etc/nginx/includes/imaging-proxy-headers.conf;
  set $orthanc_proxy http://orthanc-proxy;
  rewrite ^/imaging/(.*)$ /$1 break;
  proxy_read_timeout 300s;
  proxy_pass $orthanc_proxy;
}

location /imaging/ {
  ${IMAGING_ACCESS_CONTROL}
  include /etc/nginx/includes/imaging-proxy-headers.conf;
  set $ohif http://ohif;
  rewrite ^/imaging/(.*) /$1 break;
  proxy_buffering off;
  proxy_read_timeout 300s;
  proxy_pass $ohif;
}

# Orthanc DICOMweb endpoints for OHIF
location = /dicom-web {
  if ($imaging_read_method_denied) { return 403; }
  return 301 /dicom-web/studies;
}

location = /dicom-web/ {
  if ($imaging_read_method_denied) { return 403; }
  return 301 /dicom-web/studies;
}

location /dicom-web/ {
  if ($imaging_read_method_denied) { return 403; }
  ${IMAGING_ACCESS_CONTROL}
  include /etc/nginx/includes/imaging-proxy-headers.conf;
  set $orthanc_proxy http://orthanc-proxy;
  proxy_read_timeout 300s;
  proxy_pass $orthanc_proxy;
}

location /wado {
  if ($imaging_read_method_denied) { return 403; }
  ${IMAGING_ACCESS_CONTROL}
  include /etc/nginx/includes/imaging-proxy-headers.conf;
  set $orthanc_proxy http://orthanc-proxy;
  proxy_read_timeout 300s;
  proxy_pass $orthanc_proxy;
}

# FUA Generator Service
location = /services/fua-generator {
  return 301 /services/fua-generator/;
}

location /services/fua-generator/ {
  set $fua_upstream http://fua-generator:3000;
  # Preserve the deployed FUA contract: every subpath is sent to upstream /.
  # Changing path/query forwarding requires a separate compatibility review.
  proxy_pass $fua_upstream/;
  proxy_redirect http://$host/ /services/fua-generator/;

  # Connection/DNS failures use the fallback; upstream HTTP errors pass through.
  error_page 502 503 504 = @fua_unavailable;
}

# Location para manejar cuando fua-generator no está disponible
location @fua_unavailable {
  default_type application/json;
  return 503 '{"error": "FUA Generator service is temporarily unavailable", "status": 503}';
}

# Reportes SQL (Indicadores)
location = /openmrs/services/reportes-sql {
  return 301 /openmrs/services/reportes-sql/;
}

location /openmrs/services/reportes-sql/ {
  set $reportes_sql http://reportes-sql:8000;
  proxy_pass $reportes_sql;
  proxy_read_timeout 300s;
}

# Root redirects to home page
location = /openmrs/spa/ {
  return 301 /openmrs/spa/home;
}

location = /openmrs/spa {
  return 301 /openmrs/spa/home;
}

location = /grafana {
  if ($sihsalus_private_client = 0) { return 403; }
  if ($sihsalus_grafana_client = 0) { return 403; }
  return 301 /grafana/;
}

# Grafana expects its /grafana prefix intact (serve_from_sub_path).
location /grafana/ {
  if ($sihsalus_private_client = 0) { return 403; }
  if ($sihsalus_grafana_client = 0) { return 403; }
  set $grafana http://grafana:3000;
  # Declaring any proxy_set_header here drops every inherited one, so the
  # server-level forwarding headers have to be restated in full.
  proxy_set_header HOST $host;
  proxy_set_header X-Forwarded-Proto $forwarded_proto;
  proxy_set_header X-Real-IP $forwarded_ip;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_read_timeout 300s;
  proxy_pass $grafana;
}

location = / {
  return 301 /openmrs/spa/home;
}
