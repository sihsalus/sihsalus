map $request_uri $csp_header {
  # Dyaku/FHIR browser access is scoped to the O3 SPA. Imaging and legacy
  # surfaces must not inherit external FHIR connectivity by default.
  default "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; base-uri 'self'; font-src 'self'; img-src 'self' data:; object-src 'none'; frame-ancestors 'self' ${FRAME_ANCESTORS};";
  # The static help portal has no user input or analytics. Material for MkDocs
  # uses small inline bootstrap scripts; all network access remains same-origin.
  "~^/ayuda/" "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self'; worker-src 'self'; base-uri 'self'; font-src 'self'; img-src 'self' data:; object-src 'none'; frame-ancestors 'self' ${FRAME_ANCESTORS};";
  # The assembled SPA externalizes all executable startup code. Inline styles
  # remain temporarily required by Carbon and React component style props.
  "~^/openmrs/spa/" "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://dyaku.minsa.gob.pe; base-uri 'self'; font-src 'self'; img-src 'self' data:; object-src 'none'; frame-ancestors 'self' ${FRAME_ANCESTORS};";
  # DICOM codecs use WASM and workers; video and encapsulated PDF use blobs.
  # This policy is scoped to the viewer. Bootstrap scripts are external and
  # no external fonts or JavaScript evaluation are needed.
  "~^/imaging/" "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self' blob:; media-src 'self' blob:; base-uri 'self'; object-src 'self' blob:; frame-ancestors 'self' ${FRAME_ANCESTORS};";
  # Orthanc Explorer 2 uses Vue/Bootstrap inline styles. Its redundant inline
  # /app redirect is handled by the gateway; executable inline code stays off.
  "~^/orthanc/ui/app/" "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; base-uri 'self'; font-src 'self' data:; img-src 'self' data: blob:; object-src 'none'; frame-ancestors 'self' ${FRAME_ANCESTORS};";
  # Legacy OpenMRS pages still depend on inline scripts and eval-like behavior.
  "~^/openmrs/(?:admin|dictionary|module|patientDashboard.form|initialsetup)(?:/|$)" "default-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; base-uri 'self'; font-src 'self'; frame-ancestors 'self';";
  # Grafana ships its own bundled assets and requires inline styles, blob
  # workers and data: fonts. It is admin-only and private-network-only,
  # so this relaxation never applies to a clinical surface.
  "~^/grafana(?:/|$)" "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' data:; img-src 'self' data: blob:; worker-src 'self' blob:; media-src 'self' blob:; base-uri 'self'; object-src 'none'; frame-ancestors 'self';";
  "~^/openmrs/owa" "default-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; base-uri 'self'; font-src 'self' data:; img-src 'self' data:; frame-ancestors 'self';";
}

include /etc/nginx/conf.d/includes/imaging-auth-maps.conf;

map $http_user_agent $sihsalus_social_scraper {
  default 0;
  "~*(facebookexternalhit|facebookcatalog|whatsapp|twitterbot|telegrambot|linkedinbot|slackbot|discordbot|pinterestbot|redditbot)" 1;
}

map "$scheme:$sihsalus_social_scraper:$uri" $sihsalus_social_redirect {
  default 0;
  "~^https:1:/openmrs/?$" 1;
}

# HTTPS always forwards its own scheme; HTTP also supports a TLS terminator.
map "$scheme:$http_x_forwarded_proto" $forwarded_proto {
  default $scheme;
  "http:http" http;
  "http:https" https;
}

map $scheme $hsts_header {
  default "";
  https "max-age=31536000; includeSubDomains";
}

map $scheme $permissions_header {
  default "";
  https "geolocation=(), microphone=(), camera=()";
}

map $http_x_real_ip $forwarded_ip {
  "" $remote_addr;
  default $http_x_real_ip;
}

# Restrict Grafana by connection address, never by a client-supplied header.
# A proxy in front must enforce its own ACL; its address hides the origin.
geo $sihsalus_private_client {
  default 0;
  127.0.0.0/8 1;
  ::1/128 1;
  10.0.0.0/8 1;
  172.16.0.0/12 1;
  192.168.0.0/16 1;
  100.64.0.0/10 1;
  fd7a:115c:a1e0::/48 1;
}

# Operator-supplied Nginx geo entries. This additional, default-deny policy also
# runs before the canonical redirect; forwarding headers cannot grant access.
geo $sihsalus_grafana_client {
  default 0;
  ${GRAFANA_NETWORK_ALLOWLIST}
}

# Realtime notifications and Grafana Live use WebSocket upgrades.
map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

# Docker DNS resolver - enables lazy resolution for optional services
resolver 127.0.0.11 valid=30s ipv6=off;
resolver_timeout 5s;
