# Two independent switches must be changed during commissioning. Keep dry-run
# enabled until journal evidence shows that the local window and idle policy are
# correct for the establishment.
SIHSALUS_SAFE_POWEROFF_ENABLED=false
SIHSALUS_SAFE_POWEROFF_DRY_RUN=true

# Local server time. The timer only evaluates poweroff inside this window. A
# window such as 22:00-01:00 may cross midnight. Both values are mandatory when
# the policy is enabled; there is intentionally no repository default schedule.
SIHSALUS_SAFE_POWEROFF_NOT_BEFORE=HH:MM
SIHSALUS_SAFE_POWEROFF_NOT_AFTER=HH:MM

# A visible SPA with recent operator interaction emits a PHI-free heartbeat
# every 30 seconds. Poweroff is deferred while that timestamp is newer than
# this threshold. Do not configure less than 60 seconds; 900 is recommended.
SIHSALUS_SAFE_POWEROFF_IDLE_SECONDS=900

# Prevent an automatic poweroff shortly after a host boot. The gateway activity
# timestamp independently protects a recently recreated gateway container.
SIHSALUS_SAFE_POWEROFF_BOOT_GRACE_SECONDS=1800

# Recheck heartbeat, TCP connections, and the operator inhibit file after this
# final grace. Keep it above the 30-second SPA heartbeat period.
SIHSALUS_SAFE_POWEROFF_FINAL_GRACE_SECONDS=60

# Absolute path to the reviewed distro checkout used by the running Compose
# stack. Set this to the host's real path; do not create a second checkout only
# to satisfy the timer.
SIHSALUS_SAFE_POWEROFF_COMPOSE_DIR=/opt/sihsalus
SIHSALUS_SAFE_POWEROFF_GATEWAY_SERVICE=gateway
SIHSALUS_SAFE_POWEROFF_INHIBIT_FILE=/run/sihsalus/poweroff.inhibit
